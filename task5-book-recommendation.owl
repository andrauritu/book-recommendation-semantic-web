<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:swrl="http://www.w3.org/2003/11/swrl#"
    xmlns:ex="http://example.org/book-recommendation#">

    <owl:Ontology rdf:about="http://example.org/book-recommendation">
        <rdfs:label>Book Recommendation Ontology</rdfs:label>
        <rdfs:comment>
            A simple ontology for recommending books based on a user's preferred theme
            and reading level.
        </rdfs:comment>
    </owl:Ontology>

    <!-- Classes -->
    <owl:Class rdf:about="http://example.org/book-recommendation#User"/>
    <owl:Class rdf:about="http://example.org/book-recommendation#Book"/>
    <owl:Class rdf:about="http://example.org/book-recommendation#Theme"/>
    <owl:Class rdf:about="http://example.org/book-recommendation#ReadingLevel"/>

    <!-- Object properties -->
    <owl:ObjectProperty rdf:about="http://example.org/book-recommendation#hasPreferredTheme">
        <rdfs:domain rdf:resource="http://example.org/book-recommendation#User"/>
        <rdfs:range rdf:resource="http://example.org/book-recommendation#Theme"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/book-recommendation#hasReadingLevel">
        <rdfs:domain rdf:resource="http://example.org/book-recommendation#User"/>
        <rdfs:range rdf:resource="http://example.org/book-recommendation#ReadingLevel"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/book-recommendation#hasTheme">
        <rdfs:domain rdf:resource="http://example.org/book-recommendation#Book"/>
        <rdfs:range rdf:resource="http://example.org/book-recommendation#Theme"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/book-recommendation#suitableForReadingLevel">
        <rdfs:domain rdf:resource="http://example.org/book-recommendation#Book"/>
        <rdfs:range rdf:resource="http://example.org/book-recommendation#ReadingLevel"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/book-recommendation#recommendedFor">
        <rdfs:domain rdf:resource="http://example.org/book-recommendation#Book"/>
        <rdfs:range rdf:resource="http://example.org/book-recommendation#User"/>
    </owl:ObjectProperty>

    <!-- Variables used by the SWRL rule -->
    <swrl:Variable rdf:about="http://example.org/book-recommendation#book"/>
    <swrl:Variable rdf:about="http://example.org/book-recommendation#user"/>
    <swrl:Variable rdf:about="http://example.org/book-recommendation#theme"/>
    <swrl:Variable rdf:about="http://example.org/book-recommendation#level"/>

    <!-- Reading level individuals -->
    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation#Beginner">
        <rdf:type rdf:resource="http://example.org/book-recommendation#ReadingLevel"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation#Intermediate">
        <rdf:type rdf:resource="http://example.org/book-recommendation#ReadingLevel"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation#Advanced">
        <rdf:type rdf:resource="http://example.org/book-recommendation#ReadingLevel"/>
    </owl:NamedIndividual>

    <!-- Theme individuals -->
    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation#ScienceFiction">
        <rdf:type rdf:resource="http://example.org/book-recommendation#Theme"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation#Fantasy">
        <rdf:type rdf:resource="http://example.org/book-recommendation#Theme"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation#Mystery">
        <rdf:type rdf:resource="http://example.org/book-recommendation#Theme"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation#Murder">
        <rdf:type rdf:resource="http://example.org/book-recommendation#Theme"/>
    </owl:NamedIndividual>

    <!-- User individuals -->
    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation#Alice">
        <rdf:type rdf:resource="http://example.org/book-recommendation#User"/>
        <ex:hasReadingLevel rdf:resource="http://example.org/book-recommendation#Intermediate"/>
        <ex:hasPreferredTheme rdf:resource="http://example.org/book-recommendation#ScienceFiction"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation#Bob">
        <rdf:type rdf:resource="http://example.org/book-recommendation#User"/>
        <ex:hasReadingLevel rdf:resource="http://example.org/book-recommendation#Beginner"/>
        <ex:hasPreferredTheme rdf:resource="http://example.org/book-recommendation#Mystery"/>
    </owl:NamedIndividual>

    <!-- Book individuals -->
    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation#Dune">
        <rdf:type rdf:resource="http://example.org/book-recommendation#Book"/>
        <rdfs:label>Dune</rdfs:label>
        <ex:hasTheme rdf:resource="http://example.org/book-recommendation#ScienceFiction"/>
        <ex:hasTheme rdf:resource="http://example.org/book-recommendation#Fantasy"/>
        <ex:suitableForReadingLevel rdf:resource="http://example.org/book-recommendation#Advanced"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation#TheSilentPatient">
        <rdf:type rdf:resource="http://example.org/book-recommendation#Book"/>
        <rdfs:label>The Silent Patient</rdfs:label>
        <ex:hasTheme rdf:resource="http://example.org/book-recommendation#Mystery"/>
        <ex:hasTheme rdf:resource="http://example.org/book-recommendation#Murder"/>
        <ex:suitableForReadingLevel rdf:resource="http://example.org/book-recommendation#Intermediate"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="http://example.org/book-recommendation#HungerGames">
        <rdf:type rdf:resource="http://example.org/book-recommendation#Book"/>
        <rdfs:label>Hunger Games</rdfs:label>
        <ex:hasTheme rdf:resource="http://example.org/book-recommendation#ScienceFiction"/>
        <ex:hasTheme rdf:resource="http://example.org/book-recommendation#Fantasy"/>
        <ex:suitableForReadingLevel rdf:resource="http://example.org/book-recommendation#Beginner"/>
    </owl:NamedIndividual>

    <!-- SWRL recommendation rule:
         Book(?book) and User(?user) and hasTheme(?book, ?theme)
         and hasPreferredTheme(?user, ?theme)
         and suitableForReadingLevel(?book, ?level)
         and hasReadingLevel(?user, ?level)
         imply recommendedFor(?book, ?user). -->
    <swrl:Imp rdf:about="http://example.org/book-recommendation#RecommendationRule">
        <rdfs:label>Recommendation Rule</rdfs:label>
        <swrl:body rdf:parseType="Collection">
            <swrl:ClassAtom>
                <swrl:classPredicate rdf:resource="http://example.org/book-recommendation#Book"/>
                <swrl:argument1 rdf:resource="http://example.org/book-recommendation#book"/>
            </swrl:ClassAtom>
            <swrl:ClassAtom>
                <swrl:classPredicate rdf:resource="http://example.org/book-recommendation#User"/>
                <swrl:argument1 rdf:resource="http://example.org/book-recommendation#user"/>
            </swrl:ClassAtom>
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://example.org/book-recommendation#hasTheme"/>
                <swrl:argument1 rdf:resource="http://example.org/book-recommendation#book"/>
                <swrl:argument2 rdf:resource="http://example.org/book-recommendation#theme"/>
            </swrl:IndividualPropertyAtom>
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://example.org/book-recommendation#hasPreferredTheme"/>
                <swrl:argument1 rdf:resource="http://example.org/book-recommendation#user"/>
                <swrl:argument2 rdf:resource="http://example.org/book-recommendation#theme"/>
            </swrl:IndividualPropertyAtom>
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://example.org/book-recommendation#suitableForReadingLevel"/>
                <swrl:argument1 rdf:resource="http://example.org/book-recommendation#book"/>
                <swrl:argument2 rdf:resource="http://example.org/book-recommendation#level"/>
            </swrl:IndividualPropertyAtom>
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://example.org/book-recommendation#hasReadingLevel"/>
                <swrl:argument1 rdf:resource="http://example.org/book-recommendation#user"/>
                <swrl:argument2 rdf:resource="http://example.org/book-recommendation#level"/>
            </swrl:IndividualPropertyAtom>
        </swrl:body>
        <swrl:head rdf:parseType="Collection">
            <swrl:IndividualPropertyAtom>
                <swrl:propertyPredicate rdf:resource="http://example.org/book-recommendation#recommendedFor"/>
                <swrl:argument1 rdf:resource="http://example.org/book-recommendation#book"/>
                <swrl:argument2 rdf:resource="http://example.org/book-recommendation#user"/>
            </swrl:IndividualPropertyAtom>
        </swrl:head>
    </swrl:Imp>

</rdf:RDF>
